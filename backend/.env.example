APP_NAME="Jira Support Bot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Bot and Mini App language: en or fa (Persian)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ADMIN_IDS=your_telegram_user_id
# Comma-separated group/supergroup chat IDs the bot is allowed to work in (e.g. -1001234567890).
# The bot only responds inside these groups (private chats stay admin-only).
TELEGRAM_ALLOWED_GROUP_IDS=
# Webhook mode is disabled — the bot runs on `php artisan telegram:poll`.
# TELEGRAM_WEBHOOK_URL=

# TechDesk Mini App. Must be HTTPS; `php artisan telegram:menu-button` uses it.
# APP_DOMAIN is the public HTTPS host that serves backend/public (the Mini App and its API).
APP_DOMAIN=support.example.com
TELEGRAM_WEBAPP_URL=https://support.example.com/app/index.html
# How long (seconds) Telegram's signed launch data stays valid.
TELEGRAM_WEBAPP_MAX_AGE=86400

# Jira Data Center / Server instance base URL. Include the context path if present, e.g. https://host:8080/jira/
JIRA_BASE_URL=https://your-jira-dc.example.com/jira/
# Personal Access Token (PAT): avatar → Profile → Personal access tokens → Create token.
# Sent as "Authorization: Bearer <PAT>". Preferred over Basic auth on Data Center / Server.
JIRA_PAT=your-jira-pat-here
# Fallback Basic auth (used only when JIRA_PAT is empty):
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=
# Optional: comma-separated allowlist of project keys. Leave empty to allow every project in your Jira account.
JIRA_PROJECT_KEYS=
# Project of the support board used by /managetasks, /report, the timeline and the TechDesk Mini App.
# Empty means the first of JIRA_PROJECT_KEYS. Change it to move the bot and the app to another board.
JIRA_DEFAULT_PROJECT=
# Exact names of the optional select-list custom fields. Values must match the TaskImpact/TaskSeverity enums;
# the related pickers stay hidden while the fields do not exist on the instance.
JIRA_IMPACT_FIELD=Impact
JIRA_SEVERITY_FIELD=Severity
JIRA_OWNER_FIELD=Owner
JIRA_CATEGORY_FIELD="Ticket Category"
# Issue type used when creating tasks and reports.
JIRA_DEFAULT_ISSUE_TYPE=Task
# Optional: set the Owner field from the workflow status, as JSON (status names are case-insensitive).
# Empty turns automatic owner assignment off. Example:
# JIRA_STATUS_OWNER_MAP={"OPEN":"L1","IN PROGRESS":"L1","ESCALATED":"L2","WAITING FOR REPORTER":"Reporter","DONE":"Reporter"}
JIRA_STATUS_OWNER_MAP=

# Dates shown in the bot and the Mini App
REPORTS_TIMEZONE=UTC
# gregorian or jalali (Persian calendar)
REPORTS_CALENDAR=gregorian

# Jira API tuning (optional — all have sensible defaults)
# JIRA_REQUEST_TIMEOUT_SECONDS=25
# JIRA_CONNECT_TIMEOUT_SECONDS=20
# JIRA_RETRY_DELAY_US=300000
# JIRA_CACHE_TTL_MINUTES=60
# JIRA_SHORT_CACHE_TTL_MINUTES=30
# JIRA_MAX_LISTED_USERS=1000
# JIRA_API_PAGE_SIZE=50
# JIRA_DEFAULT_MAX_RESULTS=20

# Telegram conversation tuning (optional)
# CONVERSATION_TTL_MINUTES=5
# CONVERSATION_LOCK_SECONDS=5
# CONVERSATION_DONE_TTL_SECONDS=60

# Telegram reports tuning (optional)
# REPORTS_CONTEXT_TTL_MINUTES=30
# REPORTS_DESCRIPTION_PENDING_TTL_MINUTES=10
# REPORTS_FETCH_LIMIT=200
# REPORTS_CALLBACK_LOCK_SECONDS=30
# REPORTS_TIMEZONE=Asia/Tehran

# Status → owner map as JSON (defaults in config/services.php), e.g.
# JIRA_STATUS_OWNER_MAP={"RAISED":"L1","UPDATE PENDING":"L2"}

# Telegram polling tuning (optional)
# POLL_ERROR_BACKOFF_SECONDS=3
# POLL_DEFAULT_TIMEOUT=30
